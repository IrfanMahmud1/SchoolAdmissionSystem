# Copy to .env for local Docker runs. Never commit .env.
POSTGRES_DB=school_admission
POSTGRES_USER=school_app
POSTGRES_PASSWORD=change_this_local_password
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=school_admission;Username=school_app;Password=change_this_local_password
HOLD_DURATION_SECONDS=600
# Public browser URL; the browser runs on the host, not inside the frontend container.
VITE_API_BASE_URL=http://localhost:8080
